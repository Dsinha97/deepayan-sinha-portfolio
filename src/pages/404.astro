---
/*
 * Emitted as dist/404.html and served by the Worker, which is configured with
 * `not_found_handling: "404-page"` — see docs/wiki/deployment-domain.md.
 *
 * It uses the same layout as everything else deliberately: a 404 with no
 * header is a dead end, and the whole point of a static 404 here is that the
 * reader can navigate out of it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
	title={`Page not found — ${site.name}`}
	description="That page does not exist."
	noindex
>
	<section class="mx-auto max-w-[75rem] px-4 py-24 md:px-6 md:py-32">
		<p class="font-mono text-label uppercase text-fg-muted">Error 404</p>
		<h1 class="mt-4 font-serif text-display font-normal text-fg">Page not found</h1>
		<p class="mt-4 max-w-[65ch] text-fg-2">
			That address does not exist on this site. It may have been a typo, or a link that
			pointed somewhere that has since moved.
		</p>
		<a
			href="/"
			class="mt-8 inline-flex min-h-11 items-center rounded-control bg-accent-fill px-6 text-on-accent transition-[background-color,transform] duration-100 hover:bg-accent-fill-hover active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
		>
			Back to the homepage
		</a>
	</section>
</BaseLayout>
