---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityRail from '../components/IdentityRail.astro';
import Seam from '../components/Seam.astro';

/*
 * Homepage structure (DSI-131): a sticky identity rail beside a scrolling
 * content column, rather than a hero the reader scrolls past and loses. Taken
 * from the bento.me and portrait.so references.
 *
 * Content is still placeholder — the real sections are M3 and M4. What is real
 * here is the two-column grid, the bento spans and the section ids the
 * scroll-spy in header.js observes.
 *
 * The span classes come from a static lookup, never from concatenation.
 * Tailwind 4 scans for complete class strings: build `col-span-${n}` and it
 * emits no rule at all, and the grid silently collapses to one column. Same
 * rule that governs the classes header.js toggles.
 */
/*
 * Reflow: one column, then two at `sm`, then four at `xl`. Four columns any
 * earlier is what the first pass did, and at 1024 it produced 136px tiles with
 * "Abhijit Sinha website" wrapping to three lines — the tile grid has to
 * account for the 304px identity rail beside it, so it has far less width than
 * the viewport suggests. Caught by the responsive pass (DSI-90), not by eye.
 */
const SPAN = {
  large: 'sm:col-span-2 sm:row-span-2',
  wide: 'sm:col-span-2',
  small: '',
} as const;

/*
 * Titles are real; the copy under them is not written yet, so every tile and
 * section says "Coming soon" and nothing else. Issue numbers belong in Linear
 * and in source comments — never in text a visitor can read.
 */
const SOON = 'Coming soon.';

const tiles: { title: string; note: string; size: keyof typeof SPAN }[] = [
  { title: 'FPL Decision', note: SOON, size: 'large' },
  { title: 'Abhijit Sinha website', note: SOON, size: 'small' },
  { title: 'Fort Monroe', note: SOON, size: 'small' },
  { title: 'Recognition', note: SOON, size: 'wide' },
];

const sections = [
  { id: 'experience', title: 'Experience', note: SOON },
  { id: 'about', title: 'About', note: SOON },
  { id: 'contact', title: 'Contact', note: SOON },
];
---

<BaseLayout>
	<div
		class="mx-auto grid max-w-[75rem] gap-12 px-4 py-16 md:px-6 lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] lg:gap-16 lg:py-24"
	>
		<IdentityRail />

		<div class="min-w-0">
			<section id="work">
				<h2 class="font-serif text-h2 font-normal text-fg">Selected work</h2>
				<ul class="mt-6 grid auto-rows-[minmax(9rem,auto)] grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
					{
						tiles.map((tile) => (
							<li
								class:list={[
									'flex flex-col justify-between rounded-card border border-border bg-surface p-6',
									SPAN[tile.size],
								]}
							>
								<h3 class="font-serif text-h3 font-normal text-fg">{tile.title}</h3>
								<p class="mt-3 text-meta text-fg-muted">{tile.note}</p>
							</li>
						))
					}
				</ul>
			</section>

			{
				sections.map((section) => (
					<section id={section.id}>
						<Seam class="my-12" />
						<h2 class="font-serif text-h2 font-normal text-fg">{section.title}</h2>
						<p class="mt-3 max-w-[65ch] text-fg-2">{section.note}</p>
					</section>
				))
			}
		</div>
	</div>
</BaseLayout>
