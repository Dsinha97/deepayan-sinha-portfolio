---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityRail from '../components/IdentityRail.astro';
import Seam from '../components/Seam.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProofStrip from '../components/ProofStrip.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import { about } from '../data/profile';

/*
 * Homepage structure (DSI-131, redesigned 2026-09): a sticky identity rail
 * beside a scrolling content column, rather than a hero the reader scrolls past
 * and loses — taken from the bento.me and portrait.so references and kept when
 * the owner chose the rail over a full-width header row.
 *
 * Each section opens with a numbered label pair (SectionHeading) and is joined
 * to the next by the kintsugi seam. The closing band sits outside the column,
 * full container width, so the page ends on one strong call to action.
 *
 * The rail joins the layout at `lg` (1024). Below that it stacks above the
 * content as an ordinary block — a sticky rail on a 375px screen would eat half
 * the viewport.
 */
const [lead, ...rest] = about;
---

<BaseLayout>
	<div
		class="mx-auto grid max-w-[75rem] gap-12 px-4 pb-8 pt-12 md:px-6 lg:grid-cols-[minmax(0,17.5rem)_minmax(0,1fr)] lg:gap-16 lg:pt-20"
	>
		<IdentityRail />

		<div class="min-w-0">
			<ProofStrip />

			<section id="work" class="mt-20 md:mt-28">
				<SectionHeading eyebrow="01 · Selected work" title="Things I've built and delivered" />
				<WorkGrid />
			</section>

			<Seam class="my-16 md:my-24" />

			<section id="experience">
				<SectionHeading eyebrow="02 · Experience" title="Where the work happened" />
				<Experience />
			</section>

			<Seam class="my-16 md:my-24" />

			<section id="skills">
				<SectionHeading eyebrow="03 · Skills" title="What I work with" />
				<Skills />
			</section>

			<Seam class="my-16 md:my-24" />

			<section id="education">
				<SectionHeading eyebrow="04 · Credentials" title="Education and certificates" />
				<Education />
			</section>

			<Seam class="my-16 md:my-24" />

			<section id="about" class="grid gap-4 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
				<h2 class="font-mono text-label font-normal uppercase tracking-[0.12em] text-teal md:pt-3">05 · About</h2>
				<div class="flex max-w-[62ch] flex-col gap-5">
					<p class="font-serif text-[clamp(1.75rem,1.4rem+1.2vw,2.25rem)] leading-[1.2] text-fg">{lead}</p>
					{rest.map((paragraph) => <p class="text-lg text-fg-2">{paragraph}</p>)}
				</div>
			</section>
		</div>
	</div>

	<section id="contact" class="mx-auto mt-16 max-w-[75rem] px-4 md:mt-24 md:px-6">
		<Contact />
	</section>
</BaseLayout>
