---
/*
 * The work bento (DSI-102, reworked in the redesign after portrait.so): covers
 * run edge to edge inside large-radius tiles, with the meta line, title,
 * tagline and an arrow chip below.
 *
 * Layout: one column, two from `md`. The `lg` tile takes the full row and the
 * rest pair up beneath it.
 *
 * `section` picks which entries are listed (DSI-222): the homepage renders the
 * grid twice, once for Selected work and once for Research. Research closes
 * with a full-width tile for the published paper, from the `recognition`
 * collection: title, venue, abstract and the link, all shown, nothing to expand.
 *
 * The span classes come from a static lookup, never from concatenation.
 * Tailwind 4 scans for complete class strings.
 */
import { getCollection } from 'astro:content';
import WorkCover from './WorkCover.astro';
import IconArrowUpRight from './IconArrowUpRight.astro';

const SPAN = {
	lg: 'md:col-span-2',
	md: '',
	sm: '',
	tall: 'md:row-span-2',
} as const;

const COVER = {
	lg: 'aspect-[2/1]',
	md: 'aspect-[2/1]',
	sm: 'aspect-[2/1]',
	tall: 'min-h-80 flex-1',
} as const;

const SIZES = {
	lg: '(min-width: 1024px) 50rem, 100vw',
	md: '(min-width: 1024px) 25rem, (min-width: 768px) 50vw, 100vw',
	sm: '(min-width: 1024px) 25rem, (min-width: 768px) 50vw, 100vw',
	tall: '(min-width: 1024px) 25rem, (min-width: 768px) 50vw, 100vw',
} as const;

interface Props {
	section?: 'work' | 'research';
}

const { section = 'work' } = Astro.props;

const work = (await getCollection('work', ({ data }) => data.section === section)).sort(
	(a, b) => a.data.order - b.data.order,
);
/* The published paper sits with the research entries (owner decision,
 * 2026-11-09). Beta Gamma Sigma, the other recognition item, is in Credentials. */
const paper =
	section === 'research'
		? (await getCollection('recognition')).find((entry) => entry.data.kind === 'publication')?.data
		: undefined;

const isLive = (links?: { type: string }[]) => links?.some((link) => link.type === 'live');
---

<ul class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
	{
		work.map(({ id, data }) => (
			<li class:list={['flex', SPAN[data.bentoSize]]}>
				<a
					href={`/work/${id}/`}
					class="group flex w-full flex-col overflow-hidden rounded-tile border border-border bg-surface transition-[border-color,scale] duration-100 hover:border-border-strong active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				>
					<div class:list={['relative w-full overflow-hidden bg-surface-2', COVER[data.bentoSize]]}>
						<WorkCover
							data={data}
							sizes={SIZES[data.bentoSize]}
							eager={data.bentoSize === 'lg'}
							class="absolute inset-0 transition-transform duration-300 ease-out motion-safe:group-hover:scale-[1.02]"
						/>
					</div>
					<div class="flex items-start justify-between gap-4 p-6 md:p-7">
						<div class="flex min-w-0 flex-col gap-2">
							<p class="font-mono text-label uppercase text-fg-muted">
								{data.kicker} · {data.period}
								{isLive(data.links) && ' · Live'}
							</p>
							<h3
								class:list={[
									'font-serif font-normal leading-[1.1] text-fg',
									data.bentoSize === 'lg' ? 'text-4xl' : 'text-3xl',
								]}
							>
								{data.title}
							</h3>
							<p class="max-w-[60ch] text-fg-2">{data.tagline}</p>
						</div>
						<span
							class="flex size-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-on-accent-soft transition-transform duration-150 motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:translate-x-0.5"
							aria-hidden="true"
						>
							<IconArrowUpRight class="size-4" />
						</span>
					</div>
				</a>
			</li>
		))
	}

	{
		paper && (
			<li class="grid gap-6 rounded-tile border border-border bg-surface p-6 md:col-span-2 md:grid-cols-2 md:gap-8 md:p-8">
				<div class="flex flex-col items-start gap-4">
					<p class="font-mono text-label uppercase text-fg-muted">Published paper · ICPAT-19</p>
					<h3 class="font-serif text-3xl font-normal leading-[1.1] text-fg">{paper.title}</h3>
					{paper.venue && <p class="text-meta text-fg-muted">{paper.venue}</p>}
					{paper.href && (
						<a
							href={paper.href}
							rel="noopener"
							target="_blank"
							class="mt-auto inline-flex min-h-11 items-center gap-2 rounded-full bg-accent-fill px-5 text-on-accent transition-[background-color,scale] duration-100 hover:bg-accent-fill-hover active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>
							Read on ResearchGate
							<IconArrowUpRight class="size-4" />
							<span class="sr-only">(opens in a new tab)</span>
						</a>
					)}
				</div>
				{paper.abstract && (
					<div class="rounded-card bg-surface-2 p-5">
						<p class="font-mono text-label uppercase tracking-[0.12em] text-fg-muted">Abstract</p>
						<p class="mt-2 text-fg-2">{paper.abstract}</p>
					</div>
				)}
			</li>
		)
	}
</ul>
