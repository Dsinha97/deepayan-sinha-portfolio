---
/*
 * The sticky identity rail (DSI-131), taken from the bento.me and portrait.so
 * references: who you are stays on screen while the work scrolls past it,
 * instead of scrolling away with the hero.
 *
 * It does not replace the header. The header carries the theme toggle, the
 * resume link and the nav, and it has to exist on the case-study pages and the
 * 404 where there is no rail at all. The rail is homepage-only identity, and
 * it sticks *below* the header rather than competing with it.
 *
 * Below `lg` it is not sticky and not a column — it stacks above the content
 * as an ordinary block, which is what both references do on a phone. A sticky
 * rail on a 375px screen would eat half the viewport.
 *
 * The headshot replaces the mark here (DSI-91). The mark still appears in the
 * header, and showing it twice within one viewport was the thing to fix.
 * `<Image>` emits intrinsic width and height, so the rail cannot shift as the
 * image decodes — that is the gate on this issue, not a nicety.
 *
 * The height here must match the source's own aspect ratio (2001x3000, so
 * 240x360). Astro preserves that ratio and ignores a height that contradicts
 * it: ask for 240x320 and you still get a 360px-tall file, while the width and
 * height attributes promise 320 and the page jumps when it decodes. That is the
 * exact failure this component is supposed to prevent. Changing the width means
 * recomputing the height, not guessing it. The 3:4 frame is a CSS crop
 * (aspect-ratio + object-cover) on top of truthful intrinsic dimensions.
 *
 * Redesign: a larger name, an availability line above it, and bordered 44px
 * contact buttons. The Resume button moved to the header, where it already
 * was, so the rail no longer carries it twice.
 */
import { Image } from 'astro:assets';
import { site } from '../data/site';
import headshot from '../assets/headshot.jpg';
import IconEmail from './IconEmail.astro';
import IconGitHub from './IconGitHub.astro';
import IconLinkedIn from './IconLinkedIn.astro';
import SocialLink from './SocialLink.astro';
import { status } from '../data/profile';
---

<aside class="lg:sticky lg:top-28 lg:self-start">
	<Image
		src={headshot}
		alt={site.name}
		width={240}
		height={320}
		widths={[192, 240, 336, 384, 480]}
		sizes="(min-width: 1024px) 240px, 192px"
		loading="eager"
		fetchpriority="high"
		class="aspect-[3/4] w-48 rounded-media object-cover object-top lg:w-60"
	/>

	<p class="mt-8 flex items-center gap-2 font-mono text-label uppercase text-fg-muted">
		<span class="size-2 rounded-full bg-teal-500" aria-hidden="true"></span>
		{status}
	</p>
	<h1 class="mt-4 font-serif text-hero font-normal text-fg">{site.name}</h1>
	<p class="mt-5 max-w-[38ch] text-lg text-fg-2">{site.headline}.</p>
	<p class="mt-1 max-w-[38ch] text-fg-muted">{site.subline}</p>

	<ul class="mt-7 flex gap-2">
		<li>
			<SocialLink href={`mailto:${site.email}`} label={site.email} bordered>
				<IconEmail class="size-5" />
			</SocialLink>
		</li>
		<li>
			<SocialLink href={site.links.linkedin} label="LinkedIn" bordered>
				<IconLinkedIn class="size-5" />
			</SocialLink>
		</li>
		<li>
			<SocialLink href={site.links.github} label="GitHub" bordered>
				<IconGitHub class="size-5" />
			</SocialLink>
		</li>
	</ul>
</aside>
