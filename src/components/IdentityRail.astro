---
/*
 * The sticky identity rail (DSI-131), taken from the bento.me and portrait.so
 * references: who you are stays on screen while the work scrolls past it,
 * instead of scrolling away with the hero.
 *
 * It does not replace the header. The header carries the theme toggle, the
 * resume link and the nav, and it has to exist on the case-study pages and the
 * 404 where there is no rail at all. The rail is homepage-only identity, and
 * it sticks *below* the header rather than competing with it.
 *
 * Below `lg` it is not sticky and not a column — it stacks above the content
 * as an ordinary block, which is what both references do on a phone. A sticky
 * rail on a 375px screen would eat half the viewport.
 *
 * Content here is placeholder. The real copy is DSI-91 (positioning line) and
 * DSI-96 (contact), and the headshot lands with DSI-91 carrying explicit
 * dimensions so it cannot shift the layout.
 */
import { site } from '../data/site';
import LogoMark from './LogoMark.astro';
---

<aside class="lg:sticky lg:top-28 lg:self-start">
	<LogoMark label={`${site.name} logo`} class="w-28" />

	<h1 class="mt-8 font-serif text-display font-normal text-fg">{site.name}</h1>
	<p class="mt-3 max-w-[38ch] text-fg-2">{site.headline}</p>

	<ul class="mt-8 flex flex-col gap-1">
		<li>
			<a
				href={`mailto:${site.email}`}
				class="inline-flex min-h-11 items-center rounded-control text-fg-2 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				{site.email}
			</a>
		</li>
		<li>
			<a
				href={site.links.linkedin}
				rel="me noopener"
				class="inline-flex min-h-11 items-center rounded-control text-fg-2 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				LinkedIn
			</a>
		</li>
		<li>
			<a
				href={site.links.github}
				rel="me noopener"
				class="inline-flex min-h-11 items-center rounded-control text-fg-2 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				GitHub
			</a>
		</li>
	</ul>

	<a
		href={site.resumePath}
		class="mt-4 inline-flex min-h-11 items-center rounded-control bg-accent-fill px-6 text-on-accent transition-colors hover:bg-accent-fill-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
	>
		Resume
	</a>
</aside>
