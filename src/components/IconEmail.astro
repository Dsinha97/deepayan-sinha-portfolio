---
/*
 * Envelope glyph. Same contract as IconGitHub/IconLinkedIn — decorative,
 * `aria-hidden`, inherits `currentColor`, sized in `em`, 24x24 viewBox,
 * 2px stroke. Redrawn from the source's 40x40 filled path (DSI-169): the
 * filled version read visibly heavier than the GitHub/LinkedIn strokes
 * beside it in the same row.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width="1.125em"
	height="1.125em"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class:list={['shrink-0', className]}
>
	<rect x="2" y="4" width="20" height="16" rx="2"></rect>
	<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
</svg>
