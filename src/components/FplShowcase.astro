---
/*
 * The FPL Decision case study's app showcase (`showcase: "fpl-app"`), rendered
 * by the case-study template between the STAR block and the body:
 *
 * 1. "On this page" — two jump pills, to the tour and to the analytics map.
 * 2. "The app, screen by screen" — the app's own navigation groups, each
 *    screen with a theme-matched screenshot, a short write-up and the engines
 *    it shows. A screenshot opens full size in a script-free popover Dialog.
 * 3. "Where the analytics fits" — sources → server model → browser engines →
 *    screens, then the engine x screen matrix.
 *
 * All content lives in src/data/fpl-app.ts; the chips and the matrix are both
 * derived from its `surfaces`, so they cannot drift apart.
 */
import Dialog from './Dialog.astro';
import JumpLink from './JumpLink.astro';
import ThemeImage from './ThemeImage.astro';
import {
	browserEngines,
	chipsFor,
	engineChip,
	engines,
	groups,
	serverOutputs,
	sources,
	surfaces,
	tour,
} from '../data/fpl-app';

const eyebrow = 'font-mono text-label uppercase tracking-[0.12em] text-teal';
const laneLabel = 'font-mono text-label uppercase tracking-[0.12em] text-fg-muted';
/* A pipeline stage: its label beside its contents from md up, stacked below. */
const lane = 'grid gap-4 rounded-media p-6 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8';
const chip = 'rounded-full px-2.5 py-1 font-mono text-label';
const CHIP_TONE = {
	model: 'bg-accent-soft text-on-accent-soft',
	engine: 'bg-teal-soft text-on-teal-soft',
} as const;

const number = (entry: (typeof tour)[number]) => String(tour.indexOf(entry) + 1).padStart(2, '0');
---

<nav aria-labelledby="onpage-title" class="mt-12 flex flex-col gap-6 border-t border-border pt-10 md:flex-row md:items-center md:justify-between md:gap-8">
	<div>
		<p id="onpage-title" class={eyebrow}>On this page</p>
		<p class="mt-2 text-fg-2">Skip straight to the app itself, or to how the analytics behind it fits together.</p>
	</div>
	<div class="flex flex-wrap gap-3">
		<JumpLink href="#inside" size="lg">App overview</JumpLink>
		<JumpLink href="#analytics" size="lg">Analytics overview</JumpLink>
	</div>
</nav>

<section id="inside" aria-labelledby="inside-title" class="mt-24 md:mt-28">
	<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16">
		<div>
			<p class={eyebrow}>Inside the app</p>
			<h2 id="inside-title" class="mt-3 font-serif text-h2 font-normal text-fg">The app, screen by screen</h2>
			<p class="mt-5 max-w-[62ch] text-lg text-fg-2">
				What a manager actually opens it for. The navigation has three groups — Live for the week in front of you,
				Strategy for the weeks after it, Statistics for the players themselves — and every screen is a view onto the
				same model and the same handful of decision engines.
			</p>
		</div>
		<nav aria-label="Screen groups" class="flex flex-wrap items-center gap-2">
			<span class="mr-1 font-mono text-label uppercase tracking-[0.1em] text-fg-muted">Jump to</span>
			{groups.map((group) => <JumpLink href={`#${group.id}`}>{group.name}</JumpLink>)}
		</nav>
	</div>

	{
		groups.map((group) => (
			<section id={group.id} aria-label={group.name} class="mt-16 md:mt-24">
				<div class="flex items-center gap-4" aria-hidden="true">
					<span class="font-mono text-label uppercase tracking-[0.12em] text-fg-muted">{group.name}</span>
					<span class="h-px flex-1 bg-seam" />
				</div>

				{tour
					.filter((entry) => entry.group === group.id)
					.map((entry, i) => {
						const flip = tour.indexOf(entry) % 2 === 1;
						const paired = entry.shots.length > 1;
						const chips = chipsFor(entry);
						return (
							<article
								id={`screen-${entry.id}`}
								aria-labelledby={`tour-${entry.id}`}
								class:list={[
									'scroll-mt-24',
									i === 0 ? 'mt-10' : 'mt-16 md:mt-24',
									!paired && 'grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12',
								]}
							>
								<div class:list={[paired ? 'grid gap-6 md:grid-cols-2 md:gap-8' : 'lg:col-span-7', !paired && flip && 'lg:order-last']}>
									{entry.shots.map((shot, j) => {
										const dialogId = `shot-${entry.id}-${j}`;
										return (
											<figure>
												<button
													type="button"
													popovertarget={dialogId}
													tabindex="-1"
													aria-hidden="true"
													class="block w-full cursor-zoom-in overflow-hidden rounded-media border border-border bg-surface-2 transition-[border-color] duration-200 hover:border-border-strong"
												>
													<ThemeImage
														light={shot.light}
														dark={shot.dark}
														alt=""
														sizes={paired ? '(min-width: 768px) 36rem, 100vw' : '(min-width: 1024px) 42rem, 100vw'}
														class="h-auto w-full align-top"
													/>
												</button>
												<figcaption class="mt-2 flex items-center justify-between gap-4">
													<span class="font-mono text-meta text-fg-muted">{shot.route}</span>
													<button
														type="button"
														popovertarget={dialogId}
														class="inline-flex min-h-11 items-center gap-1.5 rounded-control px-2 text-sm text-accent transition-[color,transform] duration-100 hover:text-accent-hover active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
													>
														View full size<span class="sr-only">: {shot.alt}</span>
														<svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
															<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
														</svg>
													</button>
												</figcaption>
												<Dialog id={dialogId} labelledby={`${dialogId}-title`} width="lg">
													<Fragment slot="header">
														<h3 id={`${dialogId}-title`} class="font-serif text-3xl font-normal leading-[1.1] text-fg">{entry.title}</h3>
														<p class="mt-1 font-mono text-meta text-fg-muted">{shot.route}</p>
													</Fragment>
													<div class="bg-surface-2 p-3 md:p-6">
														<ThemeImage
															light={shot.light}
															dark={shot.dark}
															alt={shot.alt}
															sizes="(min-width: 1024px) 58rem, calc(100vw - 3rem)"
															class="h-auto w-full rounded-card border border-border align-top"
														/>
													</div>
												</Dialog>
											</figure>
										);
									})}
								</div>

								<div class:list={[paired ? 'mt-8 grid gap-4 lg:grid-cols-12 lg:gap-12' : 'lg:col-span-5']}>
									<div class:list={[paired && 'lg:col-span-5']}>
										<p class={eyebrow}>
											{number(entry)} · {entry.eyebrow}
										</p>
										<h3 id={`tour-${entry.id}`} class="mt-2 font-serif text-[clamp(2rem,1.6rem+1.2vw,2.5rem)] font-normal leading-[1.1] text-fg">
											{entry.title}
										</h3>
									</div>
									<div class:list={[paired && 'lg:col-span-7']}>
										{entry.body.map((para, k) => (
											<p class:list={['text-fg-2 md:text-[1.0625rem]', k === 0 ? (paired ? '' : 'mt-4') : 'mt-3']}>{para}</p>
										))}
										<p class="mt-6 font-mono text-label uppercase tracking-[0.1em] text-fg-muted">Analytics on this screen</p>
										<ul class="mt-2.5 flex flex-wrap gap-2">
											{chips.map((id) => (
												<li class:list={[chip, id === 'xp' ? CHIP_TONE.model : CHIP_TONE.engine]}>{engineChip[id]}</li>
											))}
										</ul>
									</div>
								</div>
							</article>
						);
					})}
			</section>
		))
	}
</section>

<section id="analytics" aria-labelledby="analytics-title" class="mt-24 rounded-band border border-border bg-surface px-4 py-10 md:mt-32 md:p-12">
	<p class={eyebrow}>Architecture</p>
	<h2 id="analytics-title" class="mt-3 font-serif text-h2 font-normal text-fg">Where the analytics fits</h2>
	<p class="mt-5 max-w-[68ch] text-lg text-fg-2">
		The model runs once, on the server, on a schedule. Every decision is then made in the browser from its output — and
		each quantity has exactly one implementation: one risk-to-points rate, one sell-price rule, one transfer simulator.
		That is why a recommendation can never disagree with the manual tool sitting beside it.
	</p>

	<ol class="mt-10 md:mt-12">
		<li class:list={[lane, 'border border-border bg-elevated']}>
			<p class={laneLabel}>1 · Sources</p>
			<ul class="grid gap-3 text-sm leading-snug sm:grid-cols-2 lg:grid-cols-5">
				{sources.map((item) => (
					<li>
						<strong class="font-semibold text-fg">{item.name}</strong>
						<br /><span class="text-fg-2">{item.detail}</span>
					</li>
				))}
			</ul>
		</li>
		<li aria-hidden="true" class="flex h-10 items-center justify-center md:justify-start md:pl-28">
			<svg viewBox="0 0 16 24" class="h-6 w-4 text-teal-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M8 2v18M2 14l6 6 6-6" />
			</svg>
		</li>
		<li class:list={[lane, 'border border-border bg-elevated']}>
			<p class={laneLabel}>2 · Server, on a schedule</p>
			<div class="grid gap-4 lg:grid-cols-[minmax(0,1.5fr)_repeat(3,minmax(0,1fr))] lg:items-start">
				<div class="rounded-card bg-accent-soft p-4 text-on-accent-soft">
					<p class="font-mono text-label">Deno · pg_cron · twice an hour</p>
					<p class="mt-1 font-serif text-[1.625rem] leading-[1.1]">Expected-points model</p>
					<p class="mt-1.5 text-meta">
						Per player, per fixture: rates shrunk towards a prior where evidence is thin, adjusted for opponent, venue
						and availability, each scoring component kept separate.
					</p>
				</div>
				{serverOutputs.map((item) => (
					<p class="text-sm leading-snug lg:pt-4">
						<strong class="font-semibold text-fg">{item.name}</strong>
						<br /><span class="text-fg-2">{item.detail}</span>
					</p>
				))}
			</div>
		</li>
		<li aria-hidden="true" class="flex h-10 items-center justify-center md:justify-start md:pl-28">
			<svg viewBox="0 0 16 24" class="h-6 w-4 text-teal-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M8 2v18M2 14l6 6 6-6" />
			</svg>
		</li>
		<li class:list={[lane, 'border border-border bg-elevated']}>
			<p class={laneLabel}>3 · Decision engines, in the browser</p>
			<ul class="grid gap-2 text-meta sm:grid-cols-2 lg:grid-cols-4">
				{browserEngines.map((item) => (
					<li class="rounded-control bg-teal-soft px-3 py-2.5 text-on-teal-soft">
						<strong class="font-semibold">{item.name}</strong>
						<br />{item.detail}
					</li>
				))}
			</ul>
		</li>
		<li aria-hidden="true" class="flex h-10 items-center justify-center md:justify-start md:pl-28">
			<svg viewBox="0 0 16 24" class="h-6 w-4 text-teal-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M8 2v18M2 14l6 6 6-6" />
			</svg>
		</li>
		<li class:list={[lane, 'bg-band text-on-band']}>
			<p class="font-mono text-label uppercase tracking-[0.12em] text-band-label">4 · Screens</p>
			<div class="grid gap-4 text-sm sm:grid-cols-3">
				{groups.map((group) => (
					<div>
						<p class="font-mono text-label uppercase tracking-[0.1em] text-on-band-2">{group.name}</p>
						<ul>
							{tour
								.filter((entry) => entry.group === group.id)
								.map((entry) => (
									<li>
										<a href={`#screen-${entry.id}`} class="inline-flex min-h-11 items-center rounded-sm underline decoration-band-line underline-offset-4 hover:text-band-label hover:decoration-band-label focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-band-label">
											{entry.title}
										</a>
									</li>
								))}
						</ul>
					</div>
				))}
			</div>
		</li>
	</ol>

	<h3 class="mt-14 font-serif text-[2rem] font-normal leading-[1.15] text-fg md:mt-16">Which engine answers on which screen</h3>
	<div class="relative mt-5 overflow-x-auto rounded-media border border-border bg-elevated" tabindex="0" role="region" aria-label="Engine by screen table, scrolls sideways">
		<table class="w-full min-w-[44rem] border-collapse text-sm">
			<caption class="caption-bottom border-t border-border px-5 py-3.5 text-left text-meta text-fg-muted">
				A filled dot means the screen shows that engine's output. The model feeds all of them.
			</caption>
			<thead>
				<tr>
					<th scope="col" class="sticky left-0 border-b border-border bg-elevated px-5 py-4 text-left font-mono text-label font-normal uppercase tracking-[0.1em] text-fg-muted">
						Engine
					</th>
					{surfaces.map((surface) => (
						<th scope="col" class="border-b border-border px-2 py-4 text-center font-mono text-label font-normal uppercase tracking-[0.06em] text-fg-muted">
							{surface.short}
						</th>
					))}
				</tr>
			</thead>
			<tbody>
				{engines.map((engine, r) => (
					<tr>
						<th scope="row" class:list={['sticky left-0 bg-elevated px-5 py-3 text-left font-medium text-fg', r < engines.length - 1 && 'border-b border-border']}>
							{engine.name}
						</th>
						{surfaces.map((surface) => {
							const on = surface.engines.includes(engine.id);
							return (
								<td class:list={['px-2 py-3 text-center', r < engines.length - 1 && 'border-b border-border']}>
									{on ? (
										<span class:list={['inline-block size-3 rounded-full', engine.id === 'xp' ? 'bg-accent' : 'bg-teal']} />
									) : (
										<span class="inline-block size-1.5 rounded-full bg-border-strong" />
									)}
									<span class="sr-only">{on ? 'Yes' : 'No'}</span>
								</td>
							);
						})}
					</tr>
				))}
			</tbody>
		</table>
	</div>
</section>
