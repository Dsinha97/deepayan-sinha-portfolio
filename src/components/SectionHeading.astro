---
/*
 * A section's label pair (redesign, from the Augen and dope.security
 * teardowns): a small numbered eyebrow in tracked mono teal above a serif
 * title. The number is ordinal decoration, not navigation, so it lives in the
 * eyebrow text rather than an ordered list.
 */
interface Props {
	eyebrow: string;
	title: string;
	/** Heading level of the title. Section titles are h2. */
	as?: 'h2' | 'h3';
	class?: string;
}

const { eyebrow, title, as: Tag = 'h2', class: className } = Astro.props;
---

<div class={className}>
	<p class="font-mono text-label uppercase tracking-[0.12em] text-teal">{eyebrow}</p>
	<Tag class="mt-3 font-serif text-h2 font-normal text-fg">{title}</Tag>
	<slot />
</div>
