---
/*
 * The kintsugi seam (DSI-115): a hairline gold join used wherever the layout
 * would otherwise draw a straight grey rule — section dividers, the underside
 * of the sticky header, the top edge of the footer.
 *
 * Three constraints shaped the implementation:
 *
 * - No extra request and no external asset. It is inline markup, so it costs
 *   bytes in the HTML and nothing in round trips, and the strict CSP never
 *   has to grow an img-src entry for it.
 * - No `style=""` attribute anywhere — the dist guard fails the build on one
 *   (docs/wiki/security-headers.md), so colour comes from a class and every
 *   other value is a plain SVG attribute.
 * - `preserveAspectRatio="none"` stretches the path to any width, and
 *   `vector-effect="non-scaling-stroke"` keeps the line a true hairline while
 *   it does. Without the second, a seam across a 1280px container renders as
 *   a fat smear.
 *
 * Decorative only: it carries no meaning a screen reader needs, so it is
 * aria-hidden and the section it separates is still a real <section>.
 */
interface Props {
  /** Extra classes on the <svg>. Colour defaults to text-seam. */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class:list={['w-full text-seam', className]}
  viewBox="0 0 1200 12"
  height="12"
  preserveAspectRatio="none"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M0 7 L96 4 L250 9 L330 5 L470 2"
    stroke-width="1.2"
    vector-effect="non-scaling-stroke"
  />
  <path
    d="M470 2 L640 8 L720 4 L880 9"
    stroke-width="2.2"
    vector-effect="non-scaling-stroke"
  />
  <path
    d="M880 9 L1010 3 L1140 7 L1200 5"
    stroke-width="1.4"
    vector-effect="non-scaling-stroke"
  />
  <path
    d="M250 9 L268 12 M470 2 L440 0 M720 4 L742 0 M1010 3 L992 0"
    stroke-width="1"
    stroke-opacity="0.5"
    vector-effect="non-scaling-stroke"
  />
</svg>
