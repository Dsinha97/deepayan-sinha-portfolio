---
/*
 * Experience timeline (DSI-93). One line of summary per role, then terse
 * bullets — not paragraphs. Reverse chronological by start date; the
 * overlapping MBA-period roles read as concurrent, which they were.
 *
 * Two things here are guardrails, not styling:
 *
 *   1. `selfReported` is kept as a separate field but is NO LONGER rendered as
 *      a visible badge — owner decision, 2026-09-11. The three Wipro figures
 *      are his own recollection rather than a retained record, and that stays
 *      recorded here, in docs/wiki/experience.md and in the vault, so nobody
 *      later mistakes them for audited numbers. Do not merge these into
 *      `points`: the field is the internal record, and collapsing it would
 *      destroy the only place the distinction survives in the code.
 *   2. The "see more" link only renders when its case study actually exists.
 *      `caseStudies` in the data module is the switch, flipped in the same
 *      change that adds the page. A link to a 404 fails DSI-107.
 *
 * See docs/wiki/content-guardrails.md and docs/wiki/experience.md.
 */
import { roles, caseStudies } from '../data/profile';
---

<ol class="mt-8 flex flex-col gap-10">
	{
		roles.map((role) => {
			const href = role.more?.href as keyof typeof caseStudies | undefined;
			const showMore = role.more && href && caseStudies[href];

			return (
				<li class="relative border-l border-border pl-6">
					{/* The seam dot: gold is decorative here, never carrying meaning alone. */}
					<span
						class="absolute -left-[3px] top-2 size-1.5 rounded-full bg-seam"
						aria-hidden="true"
					/>

					<p class="text-meta text-fg-muted">
						{role.period} · {role.place}
					</p>
					<h3 class="mt-1 font-serif text-h3 font-normal text-fg">{role.title}</h3>
					<p class="text-fg-2">{role.org}</p>

					<p class="mt-3 max-w-[65ch] text-fg-2">{role.summary}</p>

					{(role.points.length > 0 || role.selfReported) && (
						<ul class="mt-3 flex max-w-[65ch] list-disc flex-col gap-1 pl-5 text-fg-2 marker:text-seam">
							{role.points.map((point) => (
								<li>{point}</li>
							))}
							{role.selfReported?.map((point) => <li>{point}</li>)}
						</ul>
					)}

					{role.outcome && (
						<p class="mt-3 max-w-[65ch] text-fg-2">
							<span class="font-medium text-fg">Outcome — </span>
							{role.outcome}
						</p>
					)}

					{role.tools && (
						<ul class="mt-4 flex flex-wrap gap-2">
							{role.tools.map((tool) => (
								<li class="rounded-control border border-border bg-surface px-2.5 py-1 font-mono text-meta text-fg-muted">
									{tool}
								</li>
							))}
						</ul>
					)}

					{showMore && (
						<a
							href={role.more!.href}
							class="mt-4 inline-flex min-h-11 items-center rounded-control text-accent underline decoration-seam underline-offset-4 transition-colors hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
						>
							{role.more!.label}
						</a>
					)}
				</li>
			);
		})
	}
</ol>
