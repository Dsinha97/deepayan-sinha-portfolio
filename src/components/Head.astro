---
/*
 * Everything that belongs in <head>, mounted once by BaseLayout (DSI-86).
 *
 * Defaults come from `site.ts`, so a page that passes nothing still gets
 * correct metadata. The failure mode being designed against is a page shipping
 * with the homepage's description because someone forgot a prop — which is why
 * `description` has a default here rather than being required and forgotten.
 *
 * DSI-103 added Open Graph and Twitter tags and the JSON-LD slot. Every page
 * gets the tags with site defaults; a page passes `jsonLd` built by
 * src/data/schema.ts. DSI-104's generated cards replace the `image` default
 * here rather than adding a second head component.
 */
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /* Pages that exist but must never be indexed — the 404 body, for one. */
  noindex?: boolean;
  /* Root-relative path to the social card; resolved to an absolute URL below. */
  image?: string;
  type?: 'website' | 'profile' | 'article';
  /* A schema.org object from src/data/schema.ts. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = `${site.name} — ${site.headline}`,
  description = site.description,
  noindex = false,
  image = '/og-default.png',
  type = 'website',
  jsonLd,
} = Astro.props;

// `Astro.site` is the apex, hardcoded in astro.config.mjs so nothing can point
// a canonical URL at a preview host by accident.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Crawlers don't resolve relative og:image URLs.
const imageUrl = new URL(image, Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{/*
	The 404 body is a real asset at /404/ and the host serves it with a 200 there,
	so without this it is an indexable page whose content is "Page not found".
	Found on production, not locally — `astro dev` and `wrangler dev` both return
	404 for that path. The status cannot be fixed from here; the indexing can.
*/}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{/*
	A data block, not a script: the browser never executes it, so the CSP's
	script-src does not apply and no hash is needed. check-dist.mjs exempts this
	type only, and fails the build if the body isn't valid JSON.
*/}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

{/*
	Two preloads, not three. Inter carries the body and the UI; Instrument Serif
	carries the display heading, which is the largest contentful paint on every
	page — so both are on the critical path. The mono face is
	`font-display: optional` and is never the LCP, so preloading it would only
	compete with the two that are.

	crossorigin is required even same-origin: a font request is CORS-mode, and
	without it the preload is fetched twice.
*/}
<link
	rel="preload"
	href="/fonts/inter-latin-wght-normal.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/instrument-serif-latin-400-normal.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<meta name="generator" content={Astro.generator} />
