---
/*
 * Contact (DSI-96). Three published channels and nothing else — the phone
 * number, a home address and the personal Gmail are never published. See
 * docs/wiki/content-guardrails.md.
 *
 * The gate is that this works with JavaScript disabled, so the markup is a
 * plain mailto link that is already useful on its own. The copy button is
 * added by src/scripts/contact.js at runtime and is absent without JS rather
 * than present and dead — a button that does nothing is worse than no button.
 * That is also why the button is not in this markup with a JS handler bolted
 * on: no JS, no button.
 */
import { site } from '../data/site';
---

<div class="mt-6 flex max-w-[65ch] flex-col gap-4">
	<p class="text-fg-2">The fastest way to reach me is email.</p>

	<div class="flex flex-wrap items-center gap-3" data-contact>
		<a
			href={`mailto:${site.email}`}
			class="inline-flex min-h-11 items-center rounded-control bg-accent-fill px-6 text-on-accent transition-colors hover:bg-accent-fill-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			data-contact-email={site.email}
		>
			{site.email}
		</a>
	</div>

	<ul class="flex flex-wrap gap-x-6">
		<li>
			<a
				href={site.links.linkedin}
				rel="me noopener"
				class="inline-flex min-h-11 items-center rounded-control text-fg-2 underline decoration-seam underline-offset-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				LinkedIn
			</a>
		</li>
		<li>
			<a
				href={site.links.github}
				rel="me noopener"
				class="inline-flex min-h-11 items-center rounded-control text-fg-2 underline decoration-seam underline-offset-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				GitHub
			</a>
		</li>
	</ul>
</div>

<script>
	// Astro hoists this into a bundled file under /_astro/, so it is an
	// external script and `script-src 'self'` covers it with no hash.
	import '../scripts/contact.js';
</script>
