---
/*
 * Contact (DSI-96). Three published channels and nothing else — the phone
 * number, a home address and the personal Gmail are never published. See
 * docs/wiki/content-guardrails.md.
 *
 * The gate is that this works with JavaScript disabled, so the markup is a
 * plain mailto link that is already useful on its own. The copy button is
 * added by src/scripts/contact.js at runtime and is absent without JS rather
 * than present and dead — a button that does nothing is worse than no button.
 * That is also why the button is not in this markup with a JS handler bolted
 * on: no JS, no button.
 */
import { site } from '../data/site';
import IconEmail from './IconEmail.astro';
import IconGitHub from './IconGitHub.astro';
import IconLinkedIn from './IconLinkedIn.astro';
import SocialLink from './SocialLink.astro';
---

<div class="mt-6 flex max-w-[65ch] flex-col gap-4">
	<p class="text-fg-2">The fastest way to reach me is email.</p>

	<div class="flex flex-wrap items-center gap-4" data-contact>
		<a
			href={`mailto:${site.email}`}
			class="inline-flex min-h-11 items-center gap-2 rounded-control bg-accent-fill px-6 text-on-accent transition-[background-color,transform] duration-100 hover:bg-accent-fill-hover active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			data-contact-email={site.email}
		>
			<IconEmail class="size-5" />
			{site.email}
		</a>
	</div>

	<ul class="flex flex-wrap gap-2">
		<li>
			<SocialLink href={site.links.linkedin} label="LinkedIn">
				<IconLinkedIn class="size-6" />
			</SocialLink>
		</li>
		<li>
			<SocialLink href={site.links.github} label="GitHub">
				<IconGitHub class="size-6" />
			</SocialLink>
		</li>
	</ul>
</div>

<script>
	// Astro hoists this into a bundled file under /_astro/, so it is an
	// external script and `script-src 'self'` covers it with no hash.
	import '../scripts/contact.js';
</script>
