---
/*
 * Skills and toolkit (DSI-95, reworked in the redesign). One hairline-divided
 * list: the method groups from src/content/skills first, as text chips, then
 * the named software from src/data/tools.ts, each chip carrying its logo.
 *
 * No proficiency bars — a self-scored "Python 85%" tells a reader nothing and
 * invites the question of who scored it. The grouping is the information.
 *
 * The gate: every entry is evidenced elsewhere on this page or is the owner's
 * confirmed working experience. A framework that was only studied is not a
 * skill and does not belong here — see docs/wiki/skills.md.
 *
 * Logos sit on the fixed mark plate in both themes (see tools.ts). `alt=""`
 * because the chip's text already names the tool.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { toolGroups } from '../data/tools';

const groups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<dl class="mt-10 border-t border-border">
	{
		groups.map(({ data: group }) => (
			<div class="grid gap-3 border-b border-border py-5 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
				<dt class="font-mono text-label uppercase text-fg-muted md:pt-2.5">{group.group}</dt>
				<dd>
					<ul class="flex flex-wrap gap-2">
						{group.items.map((item) => (
							<li class="inline-flex min-h-10 items-center rounded-full border border-border bg-surface px-3.5 text-meta text-fg">
								{item}
							</li>
						))}
					</ul>
				</dd>
			</div>
		))
	}
	{
		toolGroups.map((group) => (
			<div class="grid gap-3 border-b border-border py-5 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
				<dt class="font-mono text-label uppercase text-fg-muted md:pt-2.5">{group.group}</dt>
				<dd>
					<ul class="flex flex-wrap gap-2">
						{group.items.map((tool) => (
							<li class="inline-flex min-h-10 items-center gap-2 rounded-full border border-border bg-surface py-1 pl-1.5 pr-3.5 text-meta text-fg">
								<span class="flex size-7 items-center justify-center rounded-full bg-mark-plate">
									<Image src={tool.logo} alt="" width={24} densities={[1, 2]} class="size-[1.125rem] object-contain" />
								</span>
								{tool.name}
							</li>
						))}
					</ul>
				</dd>
			</div>
		))
	}
</dl>
