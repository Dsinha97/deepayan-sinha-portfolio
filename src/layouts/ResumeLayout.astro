---
/*
 * The /resume/ route (DSI-97).
 *
 * The resume is a **web page rendered from markdown**, not an embedded PDF
 * viewer. That was a deliberate request and it is also the better default: a
 * PDF in an iframe is unreadable on a phone, invisible to a text search, and
 * hostile to a screen reader, and it hands the reader a viewer chrome they did
 * not ask for.
 *
 * src/pages/resume.md is the single source. There is no second copy of these
 * facts to drift — the markdown *is* the resume.
 *
 * The PDF is a real downloadable file at /resume.pdf, generated during the
 * build by scripts/build-resume-pdf.mjs from this same markdown. It cannot
 * drift from the page, because neither is a copy of the other — both are
 * rendered from one source.
 *
 * Printing this page still works and the print rules in global.css strip the
 * chrome, but the download is the path a reader is actually offered.
 *
 * Note for anyone testing locally: /resume.pdf is written into dist/ by the
 * build, so the link 404s under `astro dev`. That is the same arrangement as
 * dist/_headers and for the same reason — it is generated, not authored, and
 * a copy in public/ would be a second artifact free to go stale. Use
 * `npm run build && npm run preview` to exercise the download.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: { title: string; description: string; updated: string };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
	<div class="mx-auto max-w-[52rem] px-4 py-16 md:px-6">
		<div class="flex flex-wrap items-center justify-between gap-4 print:hidden">
			<p class="text-meta text-fg-muted">Last updated {frontmatter.updated}</p>
			<a
				href="/resume.pdf"
				download="Deepayan-Sinha-Resume.pdf"
				class="inline-flex min-h-11 items-center rounded-control bg-accent-fill px-6 text-on-accent transition-[background-color,transform] duration-100 hover:bg-accent-fill-hover active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				Download PDF
			</a>
		</div>

		<article class="resume mt-8">
			<slot />
		</article>
	</div>
</BaseLayout>
